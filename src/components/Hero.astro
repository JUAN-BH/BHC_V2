---
  const initKey = '{'
  const closeKey = '}'
---

<!-- HERO -->
<section id="hero">
  <div class="hero-content">
    <div class="hero-badge">
      <div class="badge-dot"></div>
      <span data-i18n="hero_badge">Disponible para proyectos freelance</span>
    </div>
    <h1 class="hero-title">
      Frontend<br>
      & <span class="accent">Shopify</span><br>
      <span class="line-dim">Developer.</span>
    </h1>
    <p class="hero-desc" data-i18n="hero_desc">
      Construyo interfaces rápidas y tiendas Shopify de alto rendimiento. Código limpio, experiencias que convierten.
    </p>
    <div class="hero-actions">
      <a href="#projects" class="btn-primary" data-i18n="hero_projects">Ver proyectos</a>
      <a href="#contact"  class="btn-ghost"   data-i18n="hero_talk">Hablemos</a>
      <a href="/CV_ES.pdf" download class="btn-cv" data-i18n="cv_download">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Descargar CV
      </a>
    </div>
  </div>

  <div class="hero-terminal">
    <div class="terminal">
      <div class="terminal-bar">
        <div class="dot dot-r"></div>
        <div class="dot dot-y"></div>
        <div class="dot dot-g"></div>
        <span class="t-filename">developer.json</span>
      </div>
      <div class="terminal-body">
        <div class="t-line"><span class="t-out">{initKey}</span></div>
        <div class="t-line"><span class="t-out">&nbsp;&nbsp;<span class="t-key" data-i18n="terminal_name">"nombre"</span>: <span class="t-str">"Juan Becerra"</span>,</span></div>
        <div class="t-line"><span class="t-out">&nbsp;&nbsp;<span class="t-key" data-i18n="terminal_rol">"rol"</span>: <span class="t-str">"Frontend & Shopify Dev"</span>,</span></div>
        <div class="t-line"><span class="t-out">&nbsp;&nbsp;<span class="t-key" data-i18n="terminal_exp">"exp_años"</span>: <span class="t-val">3</span>,</span></div>
        <div class="t-line">
          <span class="t-out">&nbsp;&nbsp;<span class="t-key" data-i18n="terminal_stack">"stack"</span>: [
          <span class="t-str">"React"</span>, 
          <span class="t-str">"Shopify"</span>, 
          <span class="t-str">"Liquid"</span>
          ],</span> 
        </div>
        <div class="t-line"><span class="t-out">&nbsp;&nbsp;<span class="t-key" data-i18n="terminal_location">"ubicacion"</span>: <span class="t-str">"Colombia 🇨🇴"</span>,</span></div>
        <div class="t-line"><span class="t-out">&nbsp;&nbsp;<span class="t-key" data-i18n="terminal_available">"disponible"</span>: <span class="t-val">true</span></span></div>
        <div class="t-line"><span class="t-out">{closeKey}</span></div>
      </div>
    </div>
  </div>
</section>