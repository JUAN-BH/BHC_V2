<!-- STATS -->
<div class="stats-strip">
  <div class="stat-item reveal">
    <div class="stat-number">3<span>+</span></div>
    <div class="stat-label" data-i18n="stat_exp">años de experiencia</div>
  </div>
  <div class="stat-item reveal" style="transition-delay:.07s">
    <div class="stat-number">20<span>+</span></div>
    <div class="stat-label" data-i18n="stat_projects">proyectos entregados</div>
  </div>
  <div class="stat-item reveal" style="transition-delay:.14s">
    <div class="stat-number">15<span>+</span></div>
    <div class="stat-label" data-i18n="stat_stores">tiendas Shopify</div>
  </div>
  <div class="stat-item reveal" style="transition-delay:.21s">
    <div class="stat-number">99<span>/100</span></div>
    <div class="stat-label" data-i18n="stat_vitals">Core Web Vitals</div>
  </div>
</div>

